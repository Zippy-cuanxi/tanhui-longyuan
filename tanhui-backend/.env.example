# =====================================================================
# 碳惠陇原统一后端 环境变量样例（复制为 .env 后按需修改）
# 所有【仿真参数】均为业务未确认的策略值，修改后重启生效
# 生产环境敏感项务必通过环境变量/密钥管理注入，勿提交真实凭证
# =====================================================================

# ---------- 基础 ----------
TANHUI_ENV=dev                       # dev / test / sandbox / prod
TANHUI_DEBUG=true
# JWT 签名密钥【生产必须更换为强随机值，例如 openssl rand -hex 32】
TANHUI_SECRET_KEY=dev-only-secret-key-change-me-0001
TANHUI_ACCESS_TOKEN_EXPIRE_MINUTES=30
TANHUI_REFRESH_TOKEN_EXPIRE_DAYS=14

# ---------- 数据库 ----------
# 开发默认 SQLite；生产使用 PostgreSQL（需 psycopg 驱动）：
# TANHUI_DATABASE_URL=postgresql+psycopg://tanhui:密码@db:5432/tanhui
TANHUI_DATABASE_URL=sqlite:///./tanhui_dev.db

# ---------- Redis（可选；留空=进程内存后备，仅适合开发/单实例）----------
# TANHUI_REDIS_URL=redis://localhost:6379/0
TANHUI_REDIS_URL=

# ---------- CORS 白名单【正式域名确认后修改】----------
TANHUI_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ---------- 限流（每分钟每 IP）【仿真参数】----------
TANHUI_RATE_LIMIT_PER_MINUTE=300

# ---------- 支付【SANDBOX 仿真，未接真实渠道】----------
TANHUI_PAYMENT_PROVIDER=mock_sandbox
TANHUI_MOCK_PAYMENT_SECRET=dev-mock-payment-secret   # Mock 回调签名密钥【仿真值】
TANHUI_MOCK_PAYMENT_MERCHANT_NO=MOCK8880001          # Mock 商户号【仿真值】
TANHUI_ORDER_PAY_EXPIRE_MINUTES=30                   # 支付超时（分钟）

# ---------- 运费规则【仿真参数：业务未定】----------
TANHUI_SHIPPING_FLAT_FEE=8.00        # 单店基础运费（元）
TANHUI_SHIPPING_FREE_THRESHOLD=99.00 # 单店包邮门槛（元）

# ---------- 佣金与结算【仿真参数：业务未定】----------
TANHUI_COMMISSION_RATE=0.05          # 平台佣金比例 5%
TANHUI_SETTLEMENT_PERIOD_DAYS=15     # 结算周期（天）

# ---------- 绿豆积分规则【仿真参数：业务未定】----------
TANHUI_POINTS_EARN_ENABLED=true      # 订单完成发放绿豆
TANHUI_POINTS_EARN_RATE=1            # 每消费 1 元发 1 绿豆（向下取整）
TANHUI_POINTS_DEDUCTION_ENABLED=true # 下单可用绿豆抵扣
TANHUI_POINTS_DEDUCT_RATE=100        # 100 绿豆抵 1 元
TANHUI_POINTS_DEDUCT_MAX_PERCENT=0.50 # 最多抵应付金额 50%
TANHUI_POINTS_REFUND_REVERSE_ENABLED=true # 退款冲正已发绿豆

# ---------- 管理员 MFA【仿真模式】----------
TANHUI_MFA_REQUIRED_FOR_ADMIN_LOGIN=false  # 生产建议 true
TANHUI_MFA_STRICT_HIGH_RISK=false          # 高风险操作二次验证
TANHUI_MOCK_MFA_CODE=123456                # 仿真验证码；置空禁用

# ---------- 文件上传【仿真：本地存储；生产切换 S3】----------
TANHUI_UPLOAD_DIR=./uploads
TANHUI_UPLOAD_MAX_SIZE_MB=5

# ---------- Celery（留空=任务同步执行；生产配置 broker）----------
# TANHUI_CELERY_BROKER_URL=redis://localhost:6379/1
TANHUI_CELERY_BROKER_URL=
