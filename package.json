  "type": "module",
  "description": "碳惠陇原消费者商城 Web（Vue 3 + TypeScript + Vite）",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\"",
    "test:smoke": "node scripts/smoke.mjs",
    "test:consistency": "node scripts/verify-consistency.mjs",
    "test:write-through": "node scripts/verify-write-through.mjs",
    "test:announcement": "node scripts/verify-announcement-ui.mjs",
    "test:audit-sync": "node scripts/verify-audit-mall-sync.mjs",
    "test:audit-live-ui": "node scripts/verify-catalog-live-ui.mjs",
    "test:audit-atomicity": "cd tanhui-backend && python scripts/verify_audit_atomicity.py",
    "flow:1-apply": "node scripts/flow-step1-apply.mjs",
    "flow:2-merchant": "node scripts/flow-step2-approve-merchant.mjs",
