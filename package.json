    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "beasties": "^0.5.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.1.7",
    "vue-tsc": "^3.0.6"
