    "flow:4-product": "node scripts/flow-step4-approve-product.mjs",
    "flow:4b-list": "node scripts/flow-step4b-list-product.mjs",
    "flow:5-purchase": "node scripts/flow-step5-purchase.mjs",
    "flow:6a-ship": "node scripts/flow-step6a-ship.mjs",
    "flow:6c-refund": "node scripts/flow-step6c-refund-request.mjs",
    "flow:6d-arbitrate": "node scripts/flow-step6d-arbitrate.mjs",
    "sim:data": "D:/Users/85046/anaconda3/python.exe scripts/generate_sim_data.py",
    "sim:verify": "node scripts/verify-sim-data.mjs",
    "snapshot:export": "D:/Users/85046/anaconda3/python.exe scripts/export_static_snapshot.py",
    "build:demo": "vue-tsc --noEmit && vite build --mode demo --outDir dist-demo --emptyOutDir false && node scripts/copy-404.mjs dist-demo && node scripts/prerender-shell.mjs dist-demo"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.1",
